# ---------------------------------------------------------------------------
# What is committed vs ignored — decided in Phase 1, deliberately.
#
# COMMITTED (these are the artifact):
#   results/runs/*.json      schema-validated aggregates, every README number traces here
#   results/figures/*.png    regenerated by `make report`, never hand-edited
#   results/logs/*.startup.log   trimmed engine startup logs (kernel-selection evidence)
#   docker/grafana/**        exported dashboards
#
# IGNORED (large, regenerable, or host-specific):
#   results/raw/**           per-request JSONL, hundreds of MB per sweep
#   full engine stdout       only the trimmed startup log is kept
# ---------------------------------------------------------------------------

results/raw/
results/**/*.jsonl
results/logs/*.full.log
!results/logs/*.startup.log

# Host-specific compose overrides (paths, GPU ids, HF token)
docker/compose.override.yml
.env

# Python
__pycache__/
*.py[cod]
.venv/
.venv-lmeval/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Models / datasets are never vendored — pulled from the Hub
models/
data/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
